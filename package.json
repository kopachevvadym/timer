{
  "name": "timer",
  "version": "0.1.0",
  "private": true,
  "description": "Особистий трекер часу роботи AI-агентів: хуки Claude Code → Cloudflare Worker → D1, MCP-сервер і веб-інтерфейс",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply timer --local",
    "db:migrate:remote": "wrangler d1 migrations apply timer --remote",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "^0.28.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
