{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://timer.example.com/hooks/claude",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $TIMER_API_KEY",
              "X-Project-Dir": "$CLAUDE_PROJECT_DIR"
            },
            "allowedEnvVars": [
              "TIMER_API_KEY",
              "CLAUDE_PROJECT_DIR"
            ]
          }
        ]
      }
    ],
