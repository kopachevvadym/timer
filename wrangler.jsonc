{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timer",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Лише власний домен. workers.dev і preview-URL вимкнені: одна публічна адреса, яку знає OAuth (PUBLIC_URL).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "timer.kopachev.life", "custom_domain": true }],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/hooks/*", "/mcp", "/mcp/*", "/auth/*", "/authorize", "/oauth/*", "/.well-known/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timer",
      // terraform -chdir=infra output -raw d1_database_id
      "database_id": "376725de-2097-401e-a265-7c129c21ae58",
      "migrations_dir": "migrations"
    }
  ],

  // OAuth для MCP (клієнти, гранти, токени — лише хеші). id: terraform -chdir=infra output -raw oauth_kv_id
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "35c2076f3fea4c65a3673674c160c5c4" }],

  // Обмеження частоти. LIMITER — 600 запитів на хвилину на користувача (хуки, API, MCP окремо).
  // IP_LIMITER — анонімні шляхи (OAuth, вхід) і невдалі спроби з ключем: 120 на хвилину з одного IP.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],

  // Закриває записи агентів, від яких давно не було heartbeat.
  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    // Публічна адреса сервісу (без / в кінці): redirect GitHub OAuth і ресурс MCP.
    "PUBLIC_URL": "https://timer.kopachev.life",
    // Числовий GitHub id власника (api.github.com/users/<login> → id): його перший вхід забирає дані,
    // що були до появи акаунтів. Саме id, не логін: логін можна змінити, і старий займе хтось інший.
    "OWNER_GITHUB_ID": "125369797",
    // Client ID GitHub OAuth App (секрет — wrangler secret put GITHUB_CLIENT_SECRET).
    "GITHUB_CLIENT_ID": "Ov23lijRU89lsUNZRLIk",
    "STALE_MINUTES": "20",
    "LONG_RUNNING_HOURS": "8"
  },

  "observability": { "enabled": true }
}
